# ID uses Cloudflare's client IP only when the connection comes from its published ranges.
id.updspace.com {
  tls {
    issuer acme {
      disable_tlsalpn_challenge
    }
  }
  encode zstd gzip
  @id_from_cloudflare {
    remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    header CF-Connecting-IP *
  }
  route {
    vars id_client_ip {http.request.remote.host}
    vars @id_from_cloudflare id_client_ip {http.request.header.CF-Connecting-IP}
    reverse_proxy id.updspace-id.svc.cluster.local:8089 {
      header_up X-Forwarded-For {vars.id_client_ip}
      header_up X-Real-IP {vars.id_client_ip}
    }
  }
  header -Server
}

# Portal frontend and API run on the home k3s node.
portal.updspace.com {
  tls /etc/portal-origin-tls/tls.crt /etc/portal-origin-tls/tls.key
  encode zstd gzip
  handle /api/v1/* {
    header X-Portal-Backend vm
    reverse_proxy bff.updspace-portal.svc.cluster.local:8000 {
      header_up X-Forwarded-Proto https
    }
  }
  handle {
    reverse_proxy frontend.updspace-portal.svc.cluster.local:8000
  }
  header -Server
}


errors.updspace.com {
  tls {
    issuer acme {
      disable_tlsalpn_challenge
    }
  }
  encode zstd gzip
  request_body {
    max_size 40MB
  }
  # SDK requests authenticate with project DSNs, independently of staff UI access.
  @glitchtip_ingest {
    method POST OPTIONS
    path_regexp glitchtip_ingest ^/api/[0-9]+/(envelope|minidump)/$
  }
  handle @glitchtip_ingest {
    reverse_proxy glitchtip.glitchtip.svc.cluster.local:8000
  }
  handle {
    header Cache-Control "private, no-store"
    route {
      import id_access
      reverse_proxy glitchtip.glitchtip.svc.cluster.local:8000 {
        header_up -Authorization
        stream_timeout 1m
      }
    }
  }
  header -Server
  header X-Content-Type-Options "nosniff"
}
