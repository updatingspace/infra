#!/usr/bin/env python3
"""Deploy only the collector; keep game/panel identity intact. No secret output."""
import base64
import json
import pathlib
import subprocess

ROOT = pathlib.Path(__file__).resolve().parents[2]
SSH = ['ssh', '-F', '/dev/null', '-i', str(pathlib.Path.home()/'.ssh/matveevmihail_yt'),
       '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15', '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=2', 'matveevmihail@51.250.40.253']

def main():
    state = json.loads((ROOT/'infrastructure/terraform/terraform.tfstate').read_text())
    payload = {
        'key': state['outputs']['logs_api_key']['value'],
        'collector': (ROOT/'monitoring/otel-collector.yaml').read_text(),
        'compose': (ROOT/'stack/docker-compose.yml').read_text(),
    }
    script = r'''
import base64, datetime, json, os, pathlib, subprocess, shutil, time, urllib.request
import yaml
os.umask(0o077)
p=json.loads(base64.b64decode(PAYLOAD))
root=pathlib.Path('/opt/pz-stack')
os.chdir(root)
def run(args,**kw): return subprocess.check_output(args,text=True,**kw)
def identity(service):
 cid=run(['docker','compose','ps','-q',service]).strip()
 return run(['docker','inspect','--format','{{.Id}} {{.State.StartedAt}}',cid]).strip()
before={s:identity(s) for s in ['zomboid','panel','caddy']}
metadata={p:(root/p).stat() for p in ['docker-compose.yml','monitoring/otel-collector.yaml','monitoring/monium.env']}
stamp=datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
backup=root/'backups'/('observability-'+stamp); backup.mkdir(mode=0o700)
for src in ['docker-compose.yml','monitoring/otel-collector.yaml','monitoring/monium.env']:
 shutil.copy2(root/src,backup/pathlib.Path(src).name)
old=yaml.safe_load((root/'docker-compose.yml').read_text())
new=yaml.safe_load(p['compose'])
assert set(old['services'])==set(new['services'])
for s in old['services']:
 if s!='otel-collector': assert old['services'][s]==new['services'][s],s+' changed unexpectedly'
envpath=root/'monitoring/monium.env'
env='\n'.join(x for x in envpath.read_text().splitlines() if not x.startswith('MONIUM_LOGS_API_KEY='))+'\nMONIUM_LOGS_API_KEY='+p['key']+'\n'
(root/'data/otelcol').mkdir(mode=0o700,exist_ok=True)
candidate=root/'monitoring/otel-collector.candidate.yaml'; candidate.write_text(p['collector']); candidate.chmod(0o644)
tempenv=root/'monitoring/monium.candidate.env'; tempenv.write_text(env)
image=new['services']['otel-collector']['image']
recreated=False
try:
 subprocess.run(['docker','run','--rm','--user','0:0','--cap-drop','ALL','--network','none','-v','/:/hostfs:ro','--env-file',str(tempenv),'-v',str(candidate)+':/etc/otelcol/config.yaml:ro',image,'validate','--config=/etc/otelcol/config.yaml'],check=True)
 # Atomic replacements: preserve private modes; recreate collector to see new bind mounts.
 os.replace(candidate,root/'monitoring/otel-collector.yaml')
 os.replace(tempenv,envpath)
 tmp=root/'docker-compose.candidate.yml';tmp.write_text(p['compose']);os.replace(tmp,root/'docker-compose.yml')
 for path,st in metadata.items():
  os.chmod(root/path,0o644 if path == "monitoring/otel-collector.yaml" else st.st_mode & 0o777);os.chown(root/path,st.st_uid,st.st_gid)
 subprocess.run(['docker','compose','config','--quiet'],check=True)
 recreated=True
 subprocess.run(['docker','compose','up','-d','--no-deps','--no-build','--pull','never','--force-recreate','otel-collector'],check=True)
 deadline=time.monotonic()+30
 while True:
  try:
   with urllib.request.urlopen('http://127.0.0.1:13133/',timeout=2) as response:
    assert response.status==200
   break
  except Exception:
   if time.monotonic()>deadline: raise RuntimeError('Collector readiness timeout')
   time.sleep(1)
except Exception:
 for dst in ['docker-compose.yml','monitoring/otel-collector.yaml','monitoring/monium.env']:
  shutil.copy2(backup/pathlib.Path(dst).name,root/dst)
  st=metadata[dst];os.chmod(root/dst,0o644 if dst == "monitoring/otel-collector.yaml" else st.st_mode & 0o777);os.chown(root/dst,st.st_uid,st.st_gid)
 if recreated:
  subprocess.run(['docker','compose','up','-d','--no-deps','--no-build','--pull','never','--force-recreate','otel-collector'],check=True)
 candidate.unlink(missing_ok=True);tempenv.unlink(missing_ok=True)
 raise
after={s:identity(s) for s in before}
assert before==after,'Unexpected runtime identity change'
print(json.dumps({'backup':str(backup),'unchanged':list(before),'game_identity':after['zomboid']}))
'''
    encoded=base64.b64encode(json.dumps(payload).encode()).decode()
    subprocess.run(SSH+['sudo -n python3 -'],input='PAYLOAD='+repr(encoded)+'\n'+script,text=True,check=True)

if __name__ == '__main__':
    main()
