                  "periodSeconds": 10,
                  "timeoutSeconds": 5
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": "http"
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 60
                },
                "env": [
                  {
                    "name": "GF_PATHS_DATA",
                    "value": "/var/lib/app"
                  },
                  {
                    "name": "GF_ANALYTICS_REPORTING_ENABLED",
                    "value": "false"
                  },
                  {
                    "name": "GF_ANALYTICS_CHECK_FOR_UPDATES",
                    "value": "false"
                  },
                  {
                    "name": "GF_USERS_ALLOW_SIGN_UP",
                    "value": "false"
                  },
                  {
                    "name": "GF_SERVER_ROOT_URL",
                    "value": "https://grafana.updspace.com"
                  },
                  {
                    "name": "GF_AUTH_ANONYMOUS_ENABLED",
                    "value": "false"
                  },
                  {
                    "name": "GF_SECURITY_COOKIE_SECURE",
                    "value": "true"
                  },
                  {
                    "name": "GF_SECURITY_ADMIN_USER",
                    "value": "admin"
                  },
                  {
                    "name": "GF_SECURITY_ADMIN_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "grafana-admin",
                        "key": "password"
                      }
                    }
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "hostPath": {
                  "path": "/srv/pz-monitoring/grafana",
                  "type": "Directory"
                }
              },
              {
                "name": "config0",
                "configMap": {
                  "name": "grafana-provisioning"
                }
              },
              {
                "name": "config1",
                "configMap": {
                  "name": "grafana-provisioning"
                }
              },
              {
                "name": "config2",
                "configMap": {
