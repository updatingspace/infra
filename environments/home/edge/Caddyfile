# Temporary access until ID enforces staff AND the network administrator role.
(monitoring_access) {
  tls {
    issuer acme {
      disable_tlsalpn_challenge
    }
  }
  basic_auth {
    monitoring {$MONITORING_AUTH_HASH}
  }
  header {
    -Server
    Cache-Control "private, no-store"
    X-Content-Type-Options "nosniff"
  }
}

