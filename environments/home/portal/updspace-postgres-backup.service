[Unit]
Description=Back up Portal PostgreSQL and media
After=k3s.service
Requires=k3s.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/bin/bash /opt/updspace-data/backup-postgres.sh
ExecStartPost=/usr/bin/python3 /opt/updspace-data/backup-portal-media.py
TimeoutStartSec=900
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

