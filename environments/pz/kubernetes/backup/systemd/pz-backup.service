[Unit]
OnSuccess=pz-backup-upload.service
Description=Create a verified encrypted Project Zomboid snapshot
After=k3s.service
Requires=k3s.service
RequiresMountsFor=/srv/pz-storage/zomboid /srv/pz-backup-spool
ConditionPathExists=/etc/pz-backup/enabled

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/pz-backup/coordinator.py run
User=root
Group=root
UMask=0077
StateDirectory=pz-backup
StateDirectoryMode=0700
TimeoutStartSec=infinity
TimeoutStopSec=30
KillMode=control-group
Nice=15
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=2G
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/pz-backup-spool /var/lib/pz-backup /var/lib/pz-volumes /srv/pz-storage/zomboid
ReadOnlyPaths=/var/log/pods /sys/fs/cgroup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# No Restart=always: ambiguous shutdown must be inspected, not retried.

[Install]
WantedBy=multi-user.target
