{
  email {$ACME_EMAIL}
  admin off
}

# Browser sessions belong to oauth2-proxy; every request is authorized live by ID.
(monitoring_headers) {
  tls {
    issuer acme {
      disable_tlsalpn_challenge
    }
  }
  header {
    -Server
    Cache-Control "private, no-store"
    X-Content-Type-Options "nosniff"
  }
}

(id_access) {
  request_header -X-Auth-*
  request_header -X-Observability-*
  request_header -X-Forwarded-User
  request_header -X-Forwarded-Email
  request_header -X-Forwarded-Groups
  request_header -X-Forwarded-Access-Token
  handle /oauth2/* {
    reverse_proxy oauth2-proxy.observability-auth.svc.cluster.local:4180 {
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto https
      header_up -Authorization
    }
  }
  reverse_proxy oauth2-proxy.observability-auth.svc.cluster.local:4180 {
    method GET
    rewrite /oauth2/auth
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto https
    header_up -Authorization
    @session status 2xx
    handle_response @session {
      request_header X-Observability-Token {rp.header.X-Auth-Request-Access-Token}
      # Preserve all cookie chunks and refreshes, including when authorization denies.
      copy_response_headers {
        include Set-Cookie
      }
    }
    @login status 401
    handle_response @login {
      copy_response_headers {
        include Set-Cookie
      }
      redir * /oauth2/start?rd=/ 302
    }
  }
  forward_auth id.updspace-id.svc.cluster.local:8089 {
    uri /oauth/observability-access
    header_up Authorization "Bearer {http.request.header.X-Observability-Token}"
    header_up -Cookie
  }
  request_header -X-Observability-Token
}


{$PANEL_DOMAIN} {
  encode zstd gzip
  reverse_proxy panel.zomboid.svc.cluster.local:3001 {
    health_uri /api/health
    health_interval 30s
    health_timeout 5s
    transport http {
      dial_timeout 5s
      response_header_timeout 60s
    }
  }
  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
  log {
    output stdout
    format json
  }
}

status.updspace.com {
  encode zstd gzip
  # Public status uses HTTP polling; the administrator Socket.IO endpoint stays gated.
  @public_status {
    method GET HEAD
    path / /status/updspace /status/updspace/rss /assets/* /upload/* /icon.svg /icon.png /favicon.ico /manifest.json /api/status-page/updspace /api/status-page/heartbeat/updspace /api/status-page/updspace/manifest.json /api/status-page/updspace/incident-history /api/status-page/updspace/badge
  }
  handle @public_status {
    reverse_proxy uptime-kuma.uptime-kuma.svc.cluster.local:3001
  }
  handle {
    header Cache-Control "private, no-store"
    route {
      import id_access
      reverse_proxy uptime-kuma.uptime-kuma.svc.cluster.local:3001 {
        header_up -Authorization
        stream_timeout 1m
      }
    }
  }
  header -Server
}

