[Unit]
Description=Copy encrypted Portal PostgreSQL and media backups from the VM

[Service]
Type=oneshot
UMask=0077
ExecStart=%h/.local/share/updspace-backups/portal-postgres/sync-postgres-backups.py
ExecStartPost=/usr/bin/python3 %h/.local/share/updspace-backups/portal-postgres/sync-media-backups.py
TimeoutStartSec=1200

