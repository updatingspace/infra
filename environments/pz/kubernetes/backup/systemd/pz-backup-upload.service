[Unit]
Description=Publish and read back PZ encrypted backup objects
OnSuccess=pz-backup-cleanup.service
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/pz-backup-spool
ConditionPathExists=/etc/pz-backup/upload-enabled

[Service]
Type=oneshot
User=pz-backup-upload
Group=pz-backup-remote
UMask=0077
ExecStart=/opt/pz-backup-venv/bin/python3 /opt/pz-backup/upload-queue.py
StateDirectory=pz-backup-upload
StateDirectoryMode=0700
TimeoutStartSec=infinity
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/pz-backup-spool
ReadWritePaths=/var/lib/pz-backup-upload /var/lib/pz-backup-remote
InaccessiblePaths=/etc/rancher /srv/pz-storage /var/lib/pz-volumes /root
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
