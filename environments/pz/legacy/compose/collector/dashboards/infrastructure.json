        "targets": [
          {
            "type": "monitoring",
            "dataSourceId": "monium",
            "query": "alias(100 * series_sum(non_negative_derivative({project=\"folder__b1gidr45ifb2c25bco2d\",cluster=\"pz-b42\",service=\"pz-host\",name=\"system.cpu.time\",state=\"user|system|nice|interrupt|softirq|steal\"})) / series_sum({project=\"folder__b1gidr45ifb2c25bco2d\",cluster=\"pz-b42\",service=\"pz-host\",name=\"system.cpu.logical.count\"}), \"CPU без iowait\")",
